{
  "name": "puffiflow-core",
  "private": true,
  "version": "1.0.0",
  "description": "PuffiFlow - Autonomous 4K Video Upscaling and Scheduled YouTube Publisher",
  "scripts": {
    "dev:web": "npm --prefix apps/web run dev",
    "dev:api": "npm --prefix apps/api run dev",
    "build:web": "npm --prefix apps/web run build",
    "build:api": "npm --prefix apps/api run build",
    "build": "npm run build:api && npm run build:web",
    "start:api": "npm --prefix apps/api start",
    "start:web": "npm --prefix apps/web start"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "@aws-sdk/client-s3": "^3.740.0",
    "@aws-sdk/core": "^3.740.0",
    "@aws-sdk/s3-request-presigner": "^3.740.0",
    "@aws-sdk/types": "^3.740.0",
    "autoprefixer": "^10.4.18",
    "browserslist": "^4.23.0",
    "caniuse-lite": "^1.0.30001599",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1"
  },
  "devDependencies": {
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
